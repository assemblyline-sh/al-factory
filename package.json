{
  "name": "@assemblyline/al-factory",
  "version": "0.1.1",
  "description": "Run and debug Assembly Line factory steps locally, and inspect lines, stations, workpieces and factory sessions",
  "type": "module",
  "bin": {
    "al-factory": "./bin/al-factory.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/assemblyline-sh/al-factory.git"
  },
  "homepage": "https://assemblyline.sh",
  "bugs": {
    "url": "https://github.com/assemblyline-sh/al-factory/issues"
  },
  "keywords": [
    "cli",
    "assembly-line",
    "factory",
    "orchestrator",
    "workflow",
    "pm2"
  ],
  "author": "Assembly Line",
  "license": "Apache-2.0",
  "files": [
    "bin",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "dotenv": "^16.6.1",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "jest-junit": "^16.0.0"
  }
}
